# Python bytecode
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/

# Django
*.sqlite3

# Variables de entorno — NUNCA versionar, contienen secretos
.env
.env.*
