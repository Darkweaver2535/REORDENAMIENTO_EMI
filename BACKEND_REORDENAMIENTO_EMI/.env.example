# Django
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-aleatoria-segura
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SAGA_AUTH_URL=

# PostgreSQL
DB_NAME=reordenamiento_emi
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# CORS — origenes permitidos del frontend, separados por coma (Vite usa 5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Cache (opcional para analytics en Redis)
# CACHE_URL=redis://localhost:6379/2

# IA local para Consultas Gerenciales (Ollama + gemma)
# Requiere Ollama corriendo con el modelo descargado: `ollama pull gemma4`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT=120
